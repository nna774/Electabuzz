.DS_Store

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
firmware/.pio/

# ホストテストが tag から clone してくる batch-uplink の控え
firmware/.cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
tfplan
terraform/builds/

# ビルド成果物・退避データ
build/
dist/
*.zip
*.bin

# 秘密情報（WiFi・HMAC鍵）。雛形は firmware/src/secrets.h.example
firmware/**/secrets.h

# ダッシュボードのAPI URL（環境固有）。雛形は dashboard/config.example.js
dashboard/config.js

# soak の生ログ（数日ぶんのCSV。結論はドキュメントへ書く）
soak/

# worktree（別セッションが作る作業用クローン。レポには入れない）
.claude/worktrees/

# 解析時のS3生バッチキャッシュ（→ tools/README.md）。再取得を避けるための
# 再利用資産だが、リポジトリには入れない
.s3cache/
