# GFRQ v1 ゴールデンフィクスチャ — 実装間の契約をバイト列で固定する。
#
# 版・CRC の範囲・オフセット・エンディアン・構造体のパディングの有無が、
# **全部まとめて**ここに固定されている。仕様書の文章は読まないと効かないが、
# バイト列は読まなくても壊れたら落ちる。それがこのファイルの存在理由だ。
#
# **これを書き換えてよいのは形式を変えたとき（= version を上げるとき）だけだ。**
# テストを通すために書き換えるな。それをやった瞬間、このファイルは何も守らなくなる。
#
# 読み方: '#' から行末まではコメント。空白（改行含む）は全て無視する。
# バイナリではなくテキストで持つのは、diff が読め、行にコメントを付けられるからだ
# （*.bin は .gitignore で無視される、という事情もある）。
#
# --- 生成パラメータ（firmware/lib/GridFreq/test/test_gfrq_wire.cpp と一致させること）---
#   batch_start_us   = 1750000000123456
#   device_id        = 2
#   session_id       = 7
#   f_nominal_mhz    = 50000
#   fs_measured_uhz  = 47998123456        (47998.123456 Hz)
#   tb_obs_count     = 3600
#   tb_residual_ns   = 120
#   flags            = 0x0003             (pps_locked | gnss_fix)
#   timebase_source  = 2                  (PPS)
#   soc_temp_c       = 41
#   レコード30件: cycles_q16 = 3276800 × i (= 公称50Hzちょうど), v_rms_mv = 10500, flags = 0
#   → record_count = 30, crc32 = 0xe849a2b8, 全長 424 バイト
#
# 期待される Python 側の読み: struct.unpack("<IBBHQIIIIIQIIHBbII", data[:64]) が
# 上の値を返し、zlib.crc32(data[64:]) == 0xe849a2b8 になること。

# ヘッダ 64バイト（16バイト/行）
